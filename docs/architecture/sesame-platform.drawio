er ingest (same DAG)&lt;/span&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;align=left;verticalAlign=top;spacingLeft=52;spacingTop=12;spacingRight=12;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30.0" y="785" width="609.3333333333334" height="130" as="geometry"/></mxCell><mxCell id="flow2-76" value="" style="rounded=1;arcSize=0;absoluteArcSize=1;fillColor=#16A34A;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="785" width="609.3333333333334" height="4" as="geometry"/></mxCell><mxCell id="flow2-77" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="44.0" y="801" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow2-78" value="&lt;b style=&quot;font-size:14px&quot;&gt;Outputs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155;line-height:1.7&quot;&gt;• landing: nasa_power/, weather/, soilgrids/&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155;line-height:1.7&quot;&gt;• bronze: *_raw&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155;line-height:1.7&quot;&gt;• silver: fact_weather_daily, dim_soil_layer&lt;/span&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;align=left;verticalAlign=top;spacingLeft=52;spacingTop=12;spacingRight=12;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="655.3333333333334" y="785" width="609.3333333333334" height="130" as="geometry"/></mxCell><mxCell id="flow2-79" value="" style="rounded=1;arcSize=0;absoluteArcSize=1;fillColor=#16A34A;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="655.3333333333334" y="785" width="609.3333333333334" height="4" as="geometry"/></mxCell><mxCell id="flow2-80" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+x