# MinIO (required, no built-in defaults)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=landing-zone
LAKEHOUSE_BUCKET=lakehouse

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_SENSOR_RAW=sesame.sensor.raw
KAFKA_TOPIC_SENSOR_DLQ=sesame.sensor.raw.dlq

# OpenWeatherMap
OWM_API_KEY=

# Airflow containers run as this user (Linux/WSL: output of `id -u`)
AIRFLOW_UID=50000
