<mxfile host="app.diagrams.net" agent="sesame-data-platform" version="24.7.17"><diagram name="1. High-level architecture" id="hla"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hla-t1" value="Sesame Data Platform · High-level architecture (đề xuất)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="hla-t2" value="Màu mũi tên = luồng: ① IoT streaming · ② API batch · ③ Master/reference data · ④ Xử lý Gold · ⑤ Serving &amp; ML. Nét đứt = dự kiến, chưa có code." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1500" height="24" as="geometry"/></mxCell><mxCell id="hla-c3" value="DATA SOURCES" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="270" height="760" as="geometry"/></mxCell><mxCell id="hla-c4" value="INGESTION" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="280" height="760" as="geometry"/></mxCell><mxCell id="hla-c5" value="LAKEHOUSE · MinIO (S3, Ceph ở prod) + Delta Lake · engine Apache Spark" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="860" height="760" as="geometry"/></mxCell><mxCell id="hla-c6" value="SERVING" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1530" y="90" width="340" height="760" as="geometry"/></mxCell><mxCell id="hla-v7" value="&lt;b&gt;IoT sensors&lt;/b&gt;&lt;br&gt;TEROS 12, MPS-6, SO-411, Phytos 31, SI-411, MaxiMet&lt;br&gt;&lt;i&gt;PoC: mock_iot/producer.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="230" height="90" as="geometry"/></mxCell><mxCell id="hla-v8" value="&lt;b&gt;NASA POWER&lt;/b&gt;&lt;br&gt;thời tiết ngày (ET0)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="260" width="230" height="50" as="geometry"/></mxCell><mxCell id="hla-v9" value="&lt;b&gt;OpenWeatherMap&lt;/b&gt;&lt;br&gt;thời tiết hiện tại / dự báo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="325" width="230" height="50" as="geometry"/></mxCell><mxCell id="hla-v10" value="&lt;b&gt;ISRIC SoilGrids&lt;/b&gt;&lt;br&gt;đất 0–60 cm (1 lần/farm)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="390" width="230" height="50" as="geometry"/></mxCell><mxCell id="hla-v11" value="&lt;b&gt;Google Earth Engine&lt;/b&gt;&lt;br&gt;Sentinel-2 NDVI (dự kiến)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="50" y="455" width="230" height="50" as="geometry"/></mxCell><mxCell id="hla-v12" value="&lt;b&gt;User config&lt;/b&gt;&lt;br&gt;farm · plot · season · device&lt;br&gt;&lt;i&gt;PoC: user_config_mock.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="230" height="70" as="geometry"/></mxCell><mxCell id="hla-v13" value="&lt;b&gt;Field operations&lt;/b&gt;&lt;br&gt;kế hoạch (planned) + nhật ký (done)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="645" width="230" height="55" as="geometry"/></mxCell><mxCell id="hla-v14" value="&lt;b&gt;Reference&lt;/b&gt;&lt;br&gt;FAO-56/33 + quy trình Bình Thuận&lt;br&gt;&lt;i&gt;mock_fao_db.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="715" width="230" height="70" as="geometry"/></mxCell><mxCell id="hla-v15" value="&lt;b&gt;EMQX (MQTT/TLS)&lt;/b&gt; → Kafka Connect&lt;br&gt;&lt;i&gt;prod; PoC gửi thẳng Kafka&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="350" y="130" width="240" height="55" as="geometry"/></mxCell><mxCell id="hla-v16" value="&lt;b&gt;Apache Kafka&lt;/b&gt;&lt;br&gt;sesame.sensor.raw&lt;br&gt;sesame.sensor.raw.dlq" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="200" width="240" height="70" as="geometry"/></mxCell><mxCell id="hla-v17" value="&lt;b&gt;Apache Airflow&lt;/b&gt;&lt;br&gt;DAG hằng ngày + DAG khi có thay đổi&lt;br&gt;gọi Python ingesters&lt;br&gt;(src/mock_iot/*_ingest.py)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="330" width="240" height="100" as="geometry"/></mxCell><mxCell id="hla-v18" value="&lt;b&gt;Upload config / reference&lt;/b&gt;&lt;br&gt;Python → MinIO&lt;br&gt;(sau này: form web / API)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="615" width="240" height="80" as="geometry"/></mxCell><mxCell id="hla-v19" value="&lt;b&gt;Landing zone&lt;/b&gt;&lt;br&gt;bucket landing-zone&lt;br&gt;JSON thô, Hive partition&lt;br&gt;farm_id= / dt= / season_id=" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="330" width="190" height="110" as="geometry"/></mxCell><mxCell id="hla-v20" value="&lt;b&gt;Spark Structured Streaming&lt;/b&gt;&lt;br&gt;micro-batch ~1 phút" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="160" width="190" height="70" as="geometry"/></mxCell><mxCell id="hla-v21" value="&lt;b&gt;Bronze&lt;/b&gt;&lt;br&gt;sensor_raw · nasa_power_raw · owm_raw · soilgrids_raw · user_config_raw · field_operation_raw · reference_raw&lt;br&gt;&lt;i&gt;append-only + _ingested_at&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fillColor=#f4e1c1;strokeColor=#b07d3a;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="190" height="170" as="geometry"/></mxCell><mxCell id="hla-v22" value="&lt;b&gt;Silver&lt;/b&gt;&lt;br&gt;dim_farm · dim_plot · dim_season · dim_device · dim_growth_stage · dim_soil_layer&lt;br&gt;fact_sensor_reading · fact_weather_daily · fact_field_operation · fact_harvest&lt;br&gt;quarantine_sensor" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fillColor=#e6e6e6;strokeColor=#808080;" vertex="1" parent="1"><mxGeometry x="1100" y="280" width="180" height="210" as="geometry"/></mxCell><mxCell id="hla-v23" value="&lt;b&gt;Gold&lt;/b&gt;&lt;br&gt;feat_season_daily&lt;br&gt;agg_season_summary&lt;br&gt;alert_event&lt;br&gt;yield_prediction" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fillColor=#fbeec1;strokeColor=#c9a227;" vertex="1" parent="1"><mxGeometry x="1310" y="300" width="170" height="170" as="geometry"/></mxCell><mxCell id="hla-v24" value="&lt;b&gt;Spark batch jobs&lt;/b&gt; (Airflow trigger)&lt;br&gt;Landing → Bronze → Silver → Gold&lt;br&gt;ET0, Kc(DAS), cân bằng nước, GDD, luật cảnh báo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="560" width="600" height="70" as="geometry"/></mxCell><mxCell id="hla-v25" value="&lt;b&gt;DLQ / quarantine&lt;/b&gt;&lt;br&gt;bản tin lỗi, vi phạm DQ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="700" width="190" height="60" as="geometry"/></mxCell><mxCell id="hla-t26" value="Mọi ID: farm_id → plot_id → season_id / device_id · thời gian lưu UTC, gộp theo ngày Asia/Ho_Chi_Minh" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="880" y="650" width="600" height="40" as="geometry"/></mxCell><mxCell id="hla-v27" value="&lt;b&gt;Query layer&lt;/b&gt;&lt;br&gt;Trino hoặc DuckDB đọc Delta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1550" y="130" width="300" height="60" as="geometry"/></mxCell><mxCell id="hla-v28" value="&lt;b&gt;FastAPI&lt;/b&gt; (api/)&lt;br&gt;REST cho dashboard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1550" y="215" width="300" height="55" as="geometry"/></mxCell><mxCell id="hla-v29" value="&lt;b&gt;Dashboard web&lt;/b&gt; (web/)&lt;br&gt;giám sát vụ, cảm biến, cảnh báo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1550" y="295" width="300" height="60" as="geometry"/></mxCell><mxCell id="hla-v30" value="&lt;b&gt;Dự đoán năng suất&lt;/b&gt;&lt;br&gt;baseline FAO-33 → ML khi có fact_harvest&lt;br&gt;ghi lại gold.yield_prediction" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1550" y="390" width="300" height="70" as="geometry"/></mxCell><mxCell id="hla-v31" value="&lt;b&gt;RAG chatbot&lt;/b&gt;&lt;br&gt;tài liệu canh tác + số liệu Gold" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1550" y="480" width="300" height="60" as="geometry"/></mxCell><mxCell id="hla-v32" value="&lt;b&gt;Slack&lt;/b&gt;&lt;br&gt;cảnh báo nông học + sự cố dữ liệu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1550" y="570" width="300" height="60" as="geometry"/></mxCell><mxCell id="hla-v33" value="&lt;b&gt;DATA QUALITY&lt;/b&gt; · Great Expectations: schema, khoảng giá trị vật lý, freshness, luật nghiệp vụ (tiêu chuẩn hạt, thời vụ) · chạy ở Bronze→Silver và Silver→Gold" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=12;fillColor=#eef5ee;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="30" y="880" width="1840" height="50" as="geometry"/></mxCell><mxCell id="hla-v34" value="&lt;b&gt;OBSERVABILITY&lt;/b&gt; · Grafana: freshness SLA theo nguồn, độ trễ Kafka, Z-score cảm biến · OpenLineage (Airflow, Spark) · cảnh báo Slack" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=12;fillColor=#eef2fa;strokeColor=#6c8ebf;" vertex="1" p