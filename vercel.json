{
  "framework": null,
  "functions": {
    "api/*.py": { "includeFiles": "config/**" }
  },
  "rewrites": [
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/((?!api/)[^.]*)", "destination": "/web/index.html" },
    { "source": "/((?!api/).*)", "destination": "/web/$1" }
  ]
}
