eSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1273.0" y="334.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="flow4-72" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1273.0" y="444.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="flow4-73" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1710.5" y="444.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="flow4-74" value="&lt;b style=&quot;font-size:14px&quot;&gt;Schedule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155;line-height:1.7&quot;&gt;• Daily, once flows 2 and 3 finish (Airflow sensor)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155;line-height:1.7&quot;&gt;• Aggregated by local date (UTC+7)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155;line-height:1.7&quot;&gt;• Alerts are sent as soon as they fire&lt;/span&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;align=left;verticalAlign=top;spacingLeft=52;spacingTop=12;spacingRight=12;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30.0" y="785" width="609.3333333333334" height="130" as="geometry"/></mxCell><mxCell id="flow4-75" value="" style="rounded=1;arcSize=0;absoluteArcSize=1;fillColor=#7C3AED;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="785" width="609.3333333333334" height="4" as="geometry"/></mxCell><mxCell id="flow4-76" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="44.0" y="801" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow4-77" value="&lt;b style=&quot;font-size:14px&quot;&gt;Calculations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155;line-height:1.7&quot;&gt;• FAO-56 Penman-Monteith ET0, Kc interpolated by DAS&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155;line-height:1.7&quot;&gt;• ETc = ET0 × Kc × Ks; IRn = ETc − effective rain&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155;line-height:1.7&quot;&gt;• GDD, stress days, leaf-wet hours&lt;/span&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;align=left;verticalAlign=top;spacingLeft=52;spacingTop=12;spacingRight=12;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="655.3333333333334" y="785" width="609.3333333333334" height="130" as="geometry"/></mxCell><mxCell id="flow4-78" value="" style="rounded=1;arcSize=0;absoluteArcSize=1;fillColor=#7C3AED;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="655.3333333333334" y="785" width="609.3333333333334" height="4" as="geometry"/></mxCell><mxCell id="flow4-79" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="669.3333333333334" y="801" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow4-80" value="&lt;b style=&quot;font-size:14px&quot;&gt;Status&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155;line-height:1.7&quot;&gt;• Built: ET0, Kc and soil formulas in src/common + tests&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155;line-height:1.7&quot;&gt;• Not yet: Gold Spark job, alert rules, Slack&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155;line-height:1.7&quot;&gt;• Alert thresholds tuned once real data arrives&lt;/span&gt;" style="rounded=1;arcSize=1